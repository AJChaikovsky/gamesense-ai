# Copy to .env (gitignored) and fill in what you need. Real environment variables win.

# Which model provider the live coach uses: mock (free, offline), anthropic or google.
GAMESENSE_PROVIDER=mock
# Optional model override. Defaults: claude-haiku-5-5 (anthropic), gemini-3.1-flash-lite (google).
# GAMESENSE_MODEL=

# API keys (only the one for your provider is needed).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Hard cap on estimated model spend per rolling hour, in USD (0 disables the cap).
GAMESENSE_HOURLY_BUDGET_USD=0.50

# Capture: auto (replay if GAMESENSE_REPLAY is set, live window on Windows), replay, window, none.
# GAMESENSE_CAPTURE=auto
# GAMESENSE_REPLAY=evals/clips/sample.mp4
# Window title (substring) to capture on Windows. Empty = the foreground window at startup.
# GAMESENSE_WINDOW=Counter-Strike 2

# Force the game profile instead of auto-detecting it: cs2, fromsoft_rpg, minecraft, generic.
# GAMESENSE_GAME=minecraft

# Set to 0 to run the desktop app without the in-game overlay.
# GAMESENSE_OVERLAY=1
